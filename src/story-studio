  const chapter =
    getActiveChapter();


  const overlay =
    document.createElement(
      "div"
    );

  overlay.className =
    "story-preview-overlay";


  overlay.innerHTML = `

    <div class="story-preview">

      <button
        class="preview-close"
        id="preview-close"
      >
        ×
      </button>


      <div class="preview-label">
        MUSH PREVIEW
      </div>


      <h1>
        ${escapeHTML(
          studioState.title ||
          "Untitled Story"
        )}
      </h1>


      <p class="preview-description">
        ${escapeHTML(
          studioState.description
        )}
      </p>


      <div class="preview-divider"></div>


      <h2>
        ${escapeHTML(
          chapter?.title ||
          "Chapter 1"
        )}
      </h2>


      <article class="preview-body">

        ${
          chapter?.content ||
          "<p>Your story is empty.</p>"
        }

